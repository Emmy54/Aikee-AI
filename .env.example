# ============================================================================
# Aikee AI — environment template.  Copy to .env.local and fill in the values.
# ============================================================================
# .env.local is gitignored and stays on your machine. On Vercel you enter these
# same names under: Project -> Settings -> Environment Variables.
#
# NAMES MATTER. Anything prefixed VITE_ is compiled INTO the public JavaScript
# bundle and is readable by anyone who opens devtools. So:
#   * provider secrets  -> NO VITE_ prefix (server-only)
#   * Supabase url/anon -> VITE_ prefix is fine and required (the browser needs
#     them; Row Level Security is what protects your data, not secrecy)

# --- Server-only secrets. Never give these a VITE_ prefix. ------------------
GEMINI_API_KEY=
# Optional second Gemini key, used only when the primary hits a rate limit.
GEMINI_API_KEY_FALLBACK=
GROQ_QUESTIONS_API_KEY=
STABILITY_API_KEY=

# --- Model selection (optional; sensible defaults in api/_lib/config.js) ----
# GEMINI_MODEL_PRIMARY=gemini-2.5-flash-lite
# GEMINI_MODEL_FALLBACK=gemini-2.5-flash
# GROQ_MODEL=openai/gpt-oss-20b

# --- Supabase, server side -------------------------------------------------
# Falls back to the VITE_ values below if unset, so filling those is enough.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# --- Supabase, browser side (public by design) -----------------------------
VITE_SUPABASE_PUBLIC_URL=
VITE_SUPABASE_PUBLIC_ANON_KEY=

# --- Beta gating -----------------------------------------------------------
# Full-CV generations allowed per tester.
BETA_FULL_CV_LIMIT=2
# How long each tester has, counted from their FIRST SIGN-IN (not a global
# deadline) — so a tester who is busy on launch day still gets a full window.
BETA_WINDOW_HOURS=24
# Leave unset (or "true") in production. Set to "false" ONLY for local work
# without Supabase — it disables auth AND metering on every paid endpoint.
# BETA_REQUIRE_AUTH=true

# --- Client -> API base ----------------------------------------------------
# Leave empty. The SPA and the API share one origin on Vercel, and Vite proxies
# /api to the local server in development.
# VITE_API_BASE_URL=

# --- Local API server port -------------------------------------------------
# Not used on Vercel (functions have no port).
# PORT=8787
